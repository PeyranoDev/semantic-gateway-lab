+    def cancel_pending_and_restore_stock(self, sale_id: int, grocery_id: int) -> Sale:
+        from app.application.use_cases.sale import SaleError, SaleNotFoundError
+        from app.domain.models.inventory import InventoryItem as InventoryModel
+        try:
+            # Lock and refresh the authoritative row: concurrent cancellation waits
+            # and then observes the committed status, rather than a stale entity.
+            model = (self.db.query(SaleModel)
+                     .filter(SaleModel.Id == sale_id, SaleModel.GroceryId == grocery_id)
+                     .populate_existing().with_for_update().first())
+            if model is None:
+                raise SaleNotFoundError(f"Venta {sale_id} no encontrada.")
+            if model.Status != "pending":
+                raise SaleError("Solo se pueden cancelar ventas pendientes.")
+            for item in model.Items:
+                updated = (self.db.query(InventoryModel)
+                           .filter(InventoryModel.ProductId == item.ProductId,
+                                   InventoryModel.GroceryId == grocery_id)
+                           .update({InventoryModel.Stock: InventoryModel.Stock + int(item.Quantity)},
+                                   synchronize_session=False))
+                if updated != 1:
+                    raise SaleError("No se pudo restaurar el inventario de la venta.")
+            model.Status = "cancelled"
+            self.db.flush()
+            # Materialize before commit, so conversion errors also roll back stock.
+            result = self._to_entity(model)
+            self.db.commit()
+            return result
+        except Exception:
+            self.db.rollback()
+            raise
 
